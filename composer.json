{
    "name": "jucloud/dcat-admin",
    "description": "dcat admin",
    "type": "library",
    "keywords": ["dcat", "laravel", "admin", "grid", "form", "laravel admin"],
    "homepage": "https://github.com/jqhph/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "jqh",
            "email": "841324345@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "laravel/framework": "~8.0|~9.0|~10.0|~11.0|~12.0|~13.0",
        "spatie/eloquent-sortable": "4.*"
    },
    "require-dev": {
        "laravel/dusk": "^8.3.0",
        "phpstan/phpstan": "^2.1.0",
        "phpunit/phpunit": "^12.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dcat\\Admin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
